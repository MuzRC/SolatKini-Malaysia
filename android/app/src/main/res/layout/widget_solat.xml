<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="#0a1a14">

    <!-- Header: Title and Zone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SolatKini Malaysia"
            android:textColor="#34d399"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxWidth="150dp"
            android:text="WLY01"
            android:textColor="#a7f3d0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Next Prayer Highlight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#132a20"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ Seterusnya: "
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_next_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Waktu Solat"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="--:--"
            android:textColor="#fcd34d"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 5 Prayers Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- Subuh -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subuh"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/widget_subuh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:50"
                android:textColor="#ffffff"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Zohor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zohor"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/widget_zohor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13:10"
                android:textColor="#ffffff"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Asar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asar"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/widget_asar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:20"
                android:textColor="#ffffff"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maghrib"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/widget_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:15"
                android:textColor="#ffffff"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Isyak -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Isyak"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/widget_isyak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:25"
                android:textColor="#ffffff"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
